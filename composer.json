{
  "name": "northrook/core-contracts",
  "description": "A set of Interfaces, Traits, and abstract Services for decoupled package integration.",
  "type": "library",
  "license": "BSD-3-Clause",
  "authors": [
    {
      "name": "Martin Nielsen",
      "email": "mn@northrook.com",
      "role": "Developer"
    }
  ],
  "autoload": {
    "psr-4": {
      "Northrook\\": [
        "php/app",
        "php/src"
      ],
      "Northrook\\Contracts\\": [
        "php/parameters",
        "php/contracts/assets",
        "php/contracts/handlers",
        "php/contracts/value",
        "php/Contracts",
        "php/Contracts/application",
        "php/Contracts/assets",
        "php/Contracts/attributes",
        "php/Contracts/container",
        "php/Contracts/core",
        "php/Contracts/errors",
        "php/Contracts/exceptions",
        "php/Contracts/interfaces",
        "php/Contracts/internals",
        "php/Contracts/runtime",
        "php/Contracts/services",
        "php/Contracts/structures",
        "php/Contracts/values"
      ]
    },
    "files": [
      "php/functions/debug.php",
      "php/Contracts/constants/global.php",
      "php/Contracts/constants/html.php",
      "php/Contracts/constants/logger.php",
      "php/Contracts/constants/primitives.php",
      "php/Contracts/functions/global.php",
      "php/Contracts/functions/hashes.php",
      "php/Contracts/functions/temp_path.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Northrook\\Contracts\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": ">=8.5",
    "ext-hash": "*",
    "composer-runtime-api": "^2.2",
    "psr/log": "@stable",
    "psr/cache": "@stable",
    "psr/container": "@stable",
    "psr/event-dispatcher": "@stable",
    "symfony/http-client-contracts": "^3.7",
    "ext-uri": "*",
    "ext-fileinfo": "*",
    "ext-intl": "*"
  },
  "require-dev": {
    "northrook/php-cs": "dev-main",
    "northrook/php-debug": "dev-main",
    "phpunit/phpunit": "^13",
    "phpstan/phpstan": "^2.2",
    "symfony/http-client": "^8.1",
    "symfony/var-exporter": "^8.1",
    "tempest/highlight": "^2.27"
  },
  "scripts": {
    "phpstan": "vendor/bin/phpstan analyse",
    "test": "vendor/bin/phpunit",
    "php-cs-config": "vendor/bin/php-cs-config",
    "collision": "vendor/bin/collision-check"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": false
    }
  }
}
