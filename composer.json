{
  "name": "northrook/core-contracts",
  "description": "Contracts, interfaces, traits, and global implementations.",
  "type": "library",
  "license": "BSD-3-Clause",
  "authors": [
    {
      "name": "Martin Nielsen",
      "email": "mn@northrook.com",
      "role": "Developer"
    }
  ],
  "autoload": {
    "psr-4": {
      "Northrook\\": [
        "php/contracts/assets",
        "php/contracts/container",
        "php/contracts/contract",
        "php/contracts/core", 
        "php/contracts/events",
        "php/contracts/exceptions",
        "php/contracts/error-handler",
        "php/contracts/filesystem",
        "php/contracts/interfaces",
        "php/contracts/kernel",
        "php/contracts/logger",
        "php/contracts/parameters",
        "php/contracts/runtime",
        "php/contracts/serialization",
        "php/contracts/structures",
        "php/contracts/pathfinder",
        "php/contracts/profiler",
        "php/contracts/values",
        "php/contracts/view"
      ]
    },
    "files": [
      "php/constants.php",
      "php/functions.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Northrook\\Contracts\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": ">=8.5",
    "ext-hash": "*",
    "ext-uri": "*",
    "psr/log": "@stable",
    "psr/container": "@stable",
    "psr/event-dispatcher": "@stable",
    "symfony/http-client-contracts": "^3.7",
    "composer-runtime-api": "^2.2",
    "northrook/hashes": "dev-main",
    "ext-fileinfo": "*",
    "ext-intl": "*",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "northrook/php-generator": "dev-main",
    "northrook/php-cs": "dev-main",
    "northrook/php-debug": "dev-main",
    "phpunit/phpunit": "^13",
    "phpstan/phpstan": "^2.2",
    "symfony/var-exporter": "^8.1",
    "tempest/highlight": "^2.27",
    "tracy/tracy": "^2.12"
  },
  "scripts": {
    "phpstan": "vendor/bin/phpstan analyse",
    "test": "vendor/bin/phpunit",
    "php-cs-config": "vendor/bin/php-cs-config",
    "collision": "vendor/bin/collision-check"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": false
    }
  }
}
